# =========================================================================
# NetSpout Standalone: All-In-One Docker Container (Splunk Enterprise + App)
# Includes:
#   - Splunk Enterprise 10.2 pre-configured
#   - NetSpout Splunk App with Dark NOC Canvas UI
#   - Pre-configured HEC on port 8088 (Token: 00000000-0000-0000-0000-000000000000)
#   - Pre-configured cisco_mdt_metrics (500GB Metric Index tier)
#   - Pre-configured Event Indexes (idx_network_ops, idx_security_fw, etc.)
#   - 333 SC4SNMP MIBs and OpenConfig YANG Schema Engine
#   - Universal Multi-Pipeline Telemetry Dispatcher (HEC, OTel, Telegraf, Syslog)
# =========================================================================

FROM --platform=linux/amd64 splunk/splunk:10.2

LABEL maintainer="Mahamudul Chowdhury <machowdhury@yahoo.com>"
LABEL description="Standalone Splunk Enterprise with pre-installed NetSpout Network Simulator and Telemetry App by Mahamudul Chowdhury"

USER root

# Install Python packages for standalone fast simulation engine and gNMI
RUN microdnf update -y && \
    microdnf install -y python39 python39-pip python39-setuptools python39-devel gcc && \
    python3.9 -m pip install --no-cache-dir --upgrade pip && \
    python3.9 -m pip install --no-cache-dir \
        fastapi==0.115.0 \
        uvicorn==0.30.6 \
        pydantic==2.8.2 \
        websockets==12.0 \
        grpcio>=1.59.0 \
        protobuf>=4.25.0 \
        cryptography>=41.0.0 && \
    ln -sf /usr/bin/python3.13 /usr/bin/python3 && \
    microdnf clean all

# Copy NetSpout Splunk App directly into Splunk apps directory
COPY netspout /opt/splunk/etc/apps/netspout
COPY netspout.spl /opt/splunk/etc/apps/netspout.spl

# Copy Companion Fast Simulation Engine
COPY backend /opt/netspout-backend

# Pre-configure HEC and Indexes for zero-touch instant boot
RUN mkdir -p /opt/splunk/etc/apps/netspout/local
COPY docker/standalone/inputs.conf /opt/splunk/etc/apps/netspout/local/inputs.conf
COPY docker/standalone/indexes.conf /opt/splunk/etc/apps/netspout/local/indexes.conf
RUN chown -R splunk:splunk /opt/splunk/etc/apps/netspout /opt/netspout-backend

# Set up custom startup wrapper
COPY entrypoint-standalone.sh /sbin/entrypoint-standalone.sh
RUN chmod +x /sbin/entrypoint-standalone.sh

# Environment variables for zero-prompt Splunk license acceptance
ENV SPLUNK_START_ARGS="--accept-license" \
    SPLUNK_GENERAL_TERMS="--accept-sgt-current-at-splunk-com" \
    SPLUNK_PASSWORD="SplunkPassword123!" \
    SPLUNK_HEC_PORT="8088" \
    SPLUNK_ROLE="splunk_standalone" \
    SPLUNK_HOME_OWNERSHIP_ENFORCEMENT="false" \
    FAST_SIMULATION_PORT="8081"

EXPOSE 8000 8088 8089 8081 514/udp 514/tcp

USER splunk

ENTRYPOINT ["/sbin/entrypoint-standalone.sh"]
CMD ["start-service"]
