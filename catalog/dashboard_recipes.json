      "expected_shape": {"netspout_phase": "STRING", "sourcetype": "STRING", "observations": "NUMBER"},
      "drilldowns": [{"token": "phase", "field": "netspout_phase", "semantics": "Filter all panels to the selected scenario phase."}],
      "evidence_requirements": ["SPLUNK_OBSERVED"],
      "portability": "NETSPOUT_SPECIFIC",
      "validation_requirements": ["Run and phase scoped", "Observed phase column"]
    },
