  "recipes": [
    {
      "recipe_id": "dashboard-operational-summary",
      "version": "1.0.0",
      "family": "Infrastructure Health",
      "purpose": "Summarize observed records by source and phase for the selected run.",
      "selectors": ["*"],
      "required_fields": ["netspout_run_id", "sourcetype"],
      "optional_fields": ["host", "netspout_phase"],
      "visualization_ids": ["splunk-single-value", "splunk-table"],
      "query_template": "search index=\"{index}\" {sourcetype_filter} netspout_run_id=\"{run_id}\" earliest=-15m latest=now | stats count as observed_records dc(sourcetype) as observed_sources",
      "expected_shape": {"observed_records": "NUMBER", "observed_sources": "NUMBER"},
      "drilldowns": [{"token": "source", "field": "sourcetype", "semantics": "Filter supporting telemetry by source."}],
      "evidence_requirements": ["SPLUNK_OBSERVED"],
      "portability": "NETSPOUT_SPECIFIC",
      "validation_requirements": ["Bounded run filter", "Non-empty numeric result"]
    },
    {
      "recipe_id": "dashboard-incident-timeline",
