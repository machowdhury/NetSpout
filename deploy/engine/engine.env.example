# Copy to /etc/pulseforge/engine.env (chmod 600). Values below are placeholders.
PULSEFORGE_ENGINE_HOST=127.0.0.1
PULSEFORGE_ENGINE_PORT=8081
PULSEFORGE_STATE_DIR=/var/lib/pulseforge
NETSPOUT_HEC_TOKEN=
NETSPOUT_SPLUNK_PASSWORD=
# Optional native flow collection (see docs/guides/NATIVE_FLOW_QUICKSTART.md)
#NETSPOUT_GOFLOW_METRICS_URL=http://127.0.0.1:8080/metrics
#NETSPOUT_FLOW_FORWARDER_STATUS_URL=http://127.0.0.1:8082
#NETSPOUT_COLLECTOR_HOST=127.0.0.1
