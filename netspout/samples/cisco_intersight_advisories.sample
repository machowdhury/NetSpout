arranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html](https://www.cisco.com/c/en/us/products/warranty-listing.html).\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications](https://cway.cisco.com/mynotifications).", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:45.715Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2027-12-22' ) >= -30 and datediff(current_date(), '2027-12-22' ) < 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2027-12-22T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Software Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2031-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2027-12-22T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 0, "LabelHint": "imminent", "MilestoneType": "endOfSoftwareMaintenanceDate", "Name": "End of SW Maintenance Releases(EOSM) Date", "ObjectType": "tam.Milestone", "StartOffset": -30}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "UCS-FI-6454, UCS-FI-64108, UCSX-FI-6454, UCSX-FI-64108, HCI-FI-6454, HCI-FI-64108, HCIX-FI-6454, HCIX-FI-64108"}, "AdvisoryId": "ucs-fi-6400-eosm-critical", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE '(UCS-FI-64|UCSX-FI-64|HCI-FI-64|HCIX-FI-64)' and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2026-07-07T10:59:11.284Z", "DatePublished": "2026-06-23T00:00:00Z", "DateUpdated": "2026-07-01T00:00:00Z", "Description": "Cisco announced the end-of-sale and end-of-life dates for the Cisco Fabric Interconnect 6400 Series. The end of software maintenance releases date for the affected product(s) is December 22, 2027. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-6400-series-fabric-interconnects/fabric-interconnect-6400-series-eol.html", "ModTime": "2026-09-18T18:16:45.687Z", "Moid": "6a4cdbff6f636b3901ef3798", "Name": "End of Software Maintenance Releases for the Cisco Fabric Interconnect 6400 Series is imminent", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers currently running Cisco Fabric Interconnect 6400 Series should consider migrating to the 6th Generation UCS Fabric Interconnects:\n\n- **UCS-FI-6652-U** - 6th GEN UCS Fabric Interconnect 1RU 10/25/50G Eth, 64G FC\n- **UCS-FI-6664-U** - 6th Generation UCS Fabric Interconnect 2RU 100G Eth, 64G FC\n\nCustomers may be able to use the Cisco Takeback and Reuse Program where applicable to return hardware that has reached end-of-use, at no cost. Returned products are put to their next best use, whether reused, remanufactured, or recycled by one of Cisco's certified contracted recyclers. For more information, go to: [https://www.cisco.com/c/en/us/about/takeback-and-reuse.html](https://www.cisco.com/c/en/us/about/takeback-and-reuse.html).\n\nCustomers may be able to continue to purchase the Cisco Fabric Interconnect 6400 Series through the Cisco Refresh (certified remanufactured) program. Remanufactured units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Refresh program, go to: [https://www.cisco.com/c/en/us/products/remanufactured.html](https://www.cisco.com/c/en/us/products/remanufactured.html).\n\nThe Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to: [https://www.cisco.com/c/en/us/about/takeback-and-reuse/product-recycling.html](https://www.cisco.com/c/en/us/about/takeback-and-reuse/product-recycling.html).\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html](https://www.cisco.com/c/en/us/products/eos-eol-policy.html).\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html](https://www.cisco.com/c/en/us/products/warranty-listing.html).\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications](https://cway.cisco.com/mynotifications).", "S3DataSources": [], "Severity": {"Level": "critical", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:45.687Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2026-06-23' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2026-06-23T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-12-22T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2027-12-22T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Software Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2031-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2026-06-23T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "UCS-FI-6454, UCS-FI-64108, UCSX-FI-6454, UCSX-FI-64108, HCI-FI-6454, HCI-FI-64108, HCIX-FI-6454, HCIX-FI-64108"}, "AdvisoryId": "ucs-fi-6400-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE '(UCS-FI-64|UCSX-FI-64|HCI-FI-64|HCIX-FI-64)' and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2026-07-07T10:59:11.256Z", "DatePublished": "2026-06-23T00:00:00Z", "DateUpdated": "2026-07-01T00:00:00Z", "Description": "Cisco announces the end-of-sale and end-of-life dates for the Cisco Fabric Interconnect 6400 Series. The last day to order the affected product(s) is December 22, 2026. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-6400-series-fabric-interconnects/fabric-interconnect-6400-series-eol.html", "ModTime": "2026-09-18T18:16:45.653Z", "Moid": "6a4cdbff6f636b3901ef3792", "Name": "End-of-Sale and End-of-Life Announcement for the Cisco Fabric Interconnect 6400 Series", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers currently running Cisco Fabric Interconnect 6400 Series should consider migrating to the 6th Generation UCS Fabric Interconnects:\n\n- **UCS-FI-6652-U** - 6th GEN UCS Fabric Interconnect 1RU 10/25/50G Eth, 64G FC\n- **UCS-FI-6664-U** - 6th Generation UCS Fabric Interconnect 2RU 100G Eth, 64G FC\n\nCustomers may be able to use the Cisco Takeback and Reuse Program where applicable to return hardware that has reached end-of-use, at no cost. Returned products are put to their next best use, whether reused, remanufactured, or recycled by one of Cisco's certified contracted recyclers. For more information, go to: [https://www.cisco.com/c/en/us/about/takeback-and-reuse.html](https://www.cisco.com/c/en/us/about/takeback-and-reuse.html).\n\nCustomers may be able to continue to purchase the Cisco Fabric Interconnect 6400 Series through the Cisco Refresh (certified remanufactured) program. Remanufactured units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Refresh program, go to: [https://www.cisco.com/c/en/us/products/remanufactured.html](https://www.cisco.com/c/en/us/products/remanufactured.html).\n\nThe Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to: [https://www.cisco.com/c/en/us/about/takeback-and-reuse/product-recycling.html](https://www.cisco.com/c/en/us/about/takeback-and-reuse/product-recycling.html).\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html](https://www.cisco.com/c/en/us/products/eos-eol-policy.html).\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html](https://www.cisco.com/c/en/us/products/warranty-listing.html).\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications](https://cway.cisco.com/mynotifications).", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:45.653Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2024-10-31' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2024-10-31T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2025-01-30T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2025-04-30T00:00:00Z", "Description": "The last-possible ship date that can be requested of Cisco and/or its contract manufacturers. Actual ship date is dependent on lead time.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Ship Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-01-30T00:00:00Z", "Description": "The last-possible date a routine failure analysis may be performed to determine the cause of hardware product failure or defect.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Software Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-01-30T00:00:00Z", "Description": "The last-possible date a routine failure analysis may be performed to determine the cause of hardware product failure or defect.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Routine Failure Analysis Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-01-30T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2029-04-27T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2024-10-31T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "UCS-FI-M-6324"}, "AdvisoryId": "ucs-fi-6324-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE 'UCS-FI-M-6324' and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2024-11-06T05:04:28.412Z", "DatePublished": "2024-10-31T00:00:00Z", "DateUpdated": "2024-10-29T00:00:00Z", "Description": "Cisco announces the end-of-sale and end-of-life dates for the Cisco UCS 6324 Fabric Interconnect. The last day to order the affected product(s) is January 30, 2025. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) as per EoL announcement. For customers with active and paid service and support contracts, support will be available under the terms and conditions of customers' service contract.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-6324-fabric-interconnect-eol.html", "ModTime": "2026-09-18T18:16:45.618Z", "Moid": "672af8dc6f636b39016cc377", "Name": "End-of-Life Announcement for Cisco UCS 6324 Series Fabric Interconnect", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Currently, UCS X-Series Direct Fabric Interconnect 9108 100G is the suggested replacement product. The Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to: [http://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html.](http://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications.](https://cway.cisco.com/mynotifications)", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:45.618Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2023-05-01' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2023-05-01T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2023-10-30T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-01-28T00:00:00Z", "Description": "The last-possible ship date that can be requested of Cisco and/or its contract manufacturers. Actual ship date is dependent on lead time.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Ship Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-10-29T00:00:00Z", "Description": "The last-possible date a routine failure analysis may be performed to determine the cause of hardware product failure or defect.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Routine Failure Analysis Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-10-29T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-01-25T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-10-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2023-05-01T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "UCS-FI-6332, UCS-FI-6332-16UP"}, "AdvisoryId": "ucs-fi-6332-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE 'UCS-FI-6332' and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2023-05-18T22:53:37.235Z", "DatePublished": "2023-05-01T00:00:00Z", "DateUpdated": "2023-05-02T00:00:00Z", "Description": "Cisco announces the end-of-sale and end-of life dates for the Cisco UCS Fabric Interconnect (FI 6332, FI 6332-16UP). The last day to order the affected product(s) is October 30, 2023. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) as per EoL announcement.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-fabric-interconnect-f1-6332-16up-eol.html", "ModTime": "2026-09-18T18:16:45.582Z", "Moid": "6466ac716f636b39019d5cc2", "Name": "End-of-Life Announcement for Cisco UCS 6332 Series Fabric Interconnect", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "There is no replacement available for the Cisco UCS Fabric Interconnect (FI 6332, FI 6332-16UP) at this time.\n\nCustomers may be able to use the Cisco Technology Migration Program (TMP) where applicable to trade-in eligible products and receive credit toward the purchase of new Cisco equipment. For more information about Cisco TMP, customers should work with their Cisco Partner or Cisco account team. Cisco Partners can find additional TMP information on Partner Central at [http://www.cisco.com/web/partners/incentives_and_promotions/tmp.html.](http://www.cisco.com/web/partners/incentives_and_promotions/tmp.html)\n\nCustomers may be able to continue to purchase the Cisco UCS Fabric Interconnect (FI 6332, FI 6332-16UP) through the Cisco Certified Refurbished Equipment program. Refurbished units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Certified Refurbished Equipment program, go to: [http://www.cisco.com/go/eos.](http://www.cisco.com/go/eos.)\n\nService prices for Cisco products are subject to change after the product End of Sale date.\n\nThe Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to: [http://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html.](http://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications.](https://cway.cisco.com/mynotifications)", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:45.582Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2024-05-31' ) >= -180 and datediff(current_date(), '2024-05-31' ) < -90 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2024-05-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2024-05-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete", "EndOffset": -90, "LabelHint": "upcoming", "MilestoneType": "lastDateOfSupport", "Name": "Last Date Of Support(LDOS) Date", "ObjectType": "tam.Milestone", "StartOffset": -180}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "UCS-FI-6248, UCS-FI-6296, HX-FI-6248, HX-FI-6296"}, "AdvisoryId": "ucs-fi-6200-ldos-upcoming", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE '(UCS|HX)-FI-62' and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2024-02-29T12:22:06.959Z", "DatePublished": "2020-07-28T00:00:00Z", "DateUpdated": "2020-07-28T00:00:00Z", "Description": "Cisco has announced the end-of-sale and end-of-life dates for the Cisco UCS 6200 Series Fabric Interconnects and select UCS accessories. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on End-of-Life announcement. The last day to receive applicable service and support is May 31, 2024.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-b-series-blade-servers/eos-eol-notice-c51-742066.html", "ModTime": "2026-09-18T18:16:45.547Z", "Moid": "65e076ee6f636b3901724668", "Name": "Last Date of Support for Cisco UCS 6200 Series Fabric Interconnects and select UCS accessories is upcoming", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers currently running Cisco UCS 6200 Series Fabric Interconnects and mentioned Accessories should upgrade to Cisco UCS 6400 Series Fabric Interconnects or later hardware.\n- Cisco UCS Fabric Interconnects Data Sheets can be found [here.](https://www.cisco.com/c/en/us/products/servers-unified-computing/fabric-interconnects.html#~resources)\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [http://www.cisco.com/cisco/support/notifications.html.](http://www.cisco.com/cisco/support/notifications.html)", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:45.547Z"}
