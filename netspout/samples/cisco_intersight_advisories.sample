 "Release": "6.0"}, "AdvisoryId": "ucs-6.0-eosm-critical", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_Version, ds1_BundleVersion FROM ds1 WHERE (ds1_Version RLIKE '^6\\\\.0' OR ds1_BundleVersion RLIKE '^6\\\\.0') and ds1_SourceObjectType = 'network.Element' and ds1_ManagementMode = 'UCSM'"}], "Type": "intersightApi"}], "CreateTime": "2026-09-17T03:33:52.974Z", "DatePublished": "2026-09-15T00:00:00Z", "DateUpdated": "2026-09-15T00:00:00Z", "Description": "**EOL15977**\n\nCisco announced the end-of-sale and end-of-life dates for the Cisco UCS Manager Release 6.0. The end of software maintenance releases date for the affected product(s) is December 31, 2028. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-release-6-0-eol.html", "ModTime": "2026-09-18T18:16:43.714Z", "Moid": "6aab5fa06f636b39010c3622", "Name": "End of Software Maintenance Releases for the Cisco UCS Manager Release 6.0 is imminent", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "**Product Migration Options**\n\nAfter December 31, 2028, M7- and M8-generation servers that remain managed by Cisco UCS Manager will no longer be eligible for new software maintenance releases or bug fixes. After December 31, 2030, M7- and M8-generation servers that remain managed by Cisco UCS Manager will no longer be eligible for Cisco UCS Manager support or security vulnerability fixes. Cisco provides the Intersight Managed Mode Transition Tool to assist customers in migrating from UCS Manager to Intersight Managed Mode.\n\nFor additional information related to the UCS Manager End-of-Sale and End-of-Life, please refer to the FAQs here: [https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-eol-faq.html.](https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-eol-faq.html)\n\nFor more information about the Cisco Intersight Managed Mode Transition Tool, go to: [Cisco Intersight Managed Mode Transition Tool User Guide.](https://www.cisco.com/c/en/us/td/docs/unified_computing/Intersight/IMM-Transition-Tool/User-Guide-5-0/b_imm_transition_tool_user_guide_5_0/m_overview_imm_tt_5_0.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html.](https://www.cisco.com/c/en/us/products/eos-eol-policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html.](https://www.cisco.com/c/en/us/products/warranty-listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications.](https://cway.cisco.com/mynotifications)", "S3DataSources": [], "Severity": {"Level": "critical", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.714Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2026-09-15' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2026-09-15T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2027-12-31T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-12-31T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Software Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2030-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of (Software) Support", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2026-09-15T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "6.0"}, "AdvisoryId": "ucsm-6.0-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_Version, ds1_BundleVersion FROM ds1 WHERE (ds1_Version RLIKE '^6\\\\.0' OR ds1_BundleVersion RLIKE '^6\\\\.0') and ds1_SourceObjectType = 'network.Element' and ds1_ManagementMode = 'UCSM'"}], "Type": "intersightApi"}], "CreateTime": "2026-09-17T03:33:52.93Z", "DatePublished": "2026-09-15T00:00:00Z", "DateUpdated": "2026-09-15T00:00:00Z", "Description": "**EOL15977**\n\nCisco announces the end-of-sale and end-of-life dates for the Cisco UCS Manager Release 6.0. The last day to order the affected product(s) is December 31, 2027. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin. For customers with active and paid service and support contracts, support will be available under the terms and conditions of customers' service contract.\n\nUCS Manager will continue to be supported until the Last Date of Support for Cisco UCS 5108 B-Series chassis and B200 M6 servers, currently scheduled for December 31, 2030.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-release-6-0-eol.html", "ModTime": "2026-09-18T18:16:43.681Z", "Moid": "6aab5fa06f636b39010c361d", "Name": "End-of-Sale and End-of-Life Announcement for the Cisco UCS Manager Release 6.0", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "**Product part numbers**\n\nThe following table lists the Cisco UCS Manager product part numbers affected by this announcement and the suggested Cisco Intersight migration product part numbers.\n\n| **End-of-Sale Product Part Number** | **Product Description** | **Migration Product Part Number** | **Migration Product Description** |\n|---|---|---|---|\n| N10-MGT020 | UCS Manager v6.0 | DC-MGT-IS-PVAPP-AD | Infrastructure Services PVA - Advantage |\n| N10-MGT020 | UCS Manager v6.0 | DC-MGT-IS-PVAPP-ES | Infrastructure Services PVA - Essentials |\n| N10-MGT020 | UCS Manager v6.0 | DC-MGT-IS-SAAS-AD | Infrastructure Services SaaS/CVA - Advantage |\n| N10-MGT020 | UCS Manager v6.0 | DC-MGT-IS-SAAS-ES | Infrastructure Services SaaS/CVA - Essentials |\n| N20-FW020 | UCS 5108 Blade Chassis FW Package 6.0 | DC-MGT-IS-PVAPP-AD | Infrastructure Services PVA - Advantage |\n| N20-FW020 | UCS 5108 Blade Chassis FW Package 6.0 | DC-MGT-IS-PVAPP-ES | Infrastructure Services PVA - Essentials |\n| N20-FW020 | UCS 5108 Blade Chassis FW Package 6.0 | DC-MGT-IS-SAAS-AD | Infrastructure Services SaaS/CVA - Advantage |\n| N20-FW020 | UCS 5108 Blade Chassis FW Package 6.0 | DC-MGT-IS-SAAS-ES | Infrastructure Services SaaS/CVA - Essentials |\n\n**Product Migration Options**\n\nAfter December 31, 2028, M7- and M8-generation servers that remain managed by Cisco UCS Manager will no longer be eligible for new software maintenance releases or bug fixes. After December 31, 2030, M7- and M8-generation servers that remain managed by Cisco UCS Manager will no longer be eligible for Cisco UCS Manager support or security vulnerability fixes. Cisco provides the Intersight Managed Mode Transition Tool to assist customers in migrating from UCS Manager to Intersight Managed Mode.\n\nFor additional information related to the UCS Manager End-of-Sale and End-of-Life, please refer to the FAQs here: [https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-eol-faq.html.](https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-eol-faq.html)\n\nFor more information about the Cisco Intersight Managed Mode Transition Tool, go to: [Cisco Intersight Managed Mode Transition Tool User Guide.](https://www.cisco.com/c/en/us/td/docs/unified_computing/Intersight/IMM-Transition-Tool/User-Guide-5-0/b_imm_transition_tool_user_guide_5_0/m_overview_imm_tt_5_0.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html.](https://www.cisco.com/c/en/us/products/eos-eol-policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html.](https://www.cisco.com/c/en/us/products/warranty-listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications.](https://cway.cisco.com/mynotifications)", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.681Z"}
