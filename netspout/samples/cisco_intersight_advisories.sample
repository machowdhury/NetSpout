{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "equipment.Chassis", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2025-04-02' ) >= 0 )"}], "Type": "restApi"}, {"AffectedObjectType": "compute.Blade", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds2_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds2 where ( datediff(current_date(), '2025-04-02' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2025-04-02T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2025-12-31T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-03-31T00:00:00Z", "Description": "The last-possible ship date that can be requested of Cisco and/or its contract manufacturers. Actual ship date is dependent on lead time.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Ship Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-12-31T00:00:00Z", "Description": "The last-possible date a routine failure analysis may be performed to determine the cause of hardware product failure or defect.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Routine Failure Analysis Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-12-31T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2030-03-31T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2030-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of (Hardware) Support", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2025-04-02T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "B220 M6, 5108 AC2"}, "AdvisoryId": "ucs-b200