", "Ancestors": [], "ApiDataSources": [{"MoType": "computePhysicalSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE 'UCS.*(C220|C240|C460).*M4' and ds1_SourceObjectType = 'compute.RackUnit'"}], "Type": "intersightApi"}], "CreateTime": "2024-03-04T10:22:39.598Z", "DatePublished": "2018-08-16T00:00:00Z", "DateUpdated": "2019-08-24T00:00:00Z", "Description": "Cisco has announced the end-of-sale and end-of-life dates for the Cisco Unified Computing System C-Series Rack Severs (C220 M4, C240 M4 and C460 M4). Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on End of Life announcement. The last day to receive applicable service and support is February 29, 2024.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-c-series-rack-servers/eos-eol-notice-c51-741235.html", "ModTime": "2026-09-18T18:16:44.385Z", "Moid": "65e5a0ef6f636b390176db1e", "Name": "Last Date of Support for Cisco UCS C-Series M4 Rack Severs (C220 M4, C240 M4 and C460 M4) is past", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers currently running Cisco UCS C220 M4, C240 M4 and C460 M4 hardware should upgrade to Cisco UCS C-Series M5 or later hardware.\n- Cisco UCS C-Series Rack Servers Data Sheets can be found [here.](https://www.cisco.com/c/en/us/products/servers-unified-computing/ucs-c-series-rack-servers/datasheet-listing.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\n For more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\n To subscribe to receive end-of-life/end-of-sale information, go to: [http://www.cisco.com/cisco/support/notifications.html.](http://www.cisco.com/cisco/support/notifications.html)\n", "S3DataSources": [], "Severity": {"Level": "critical", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:44.385Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "compute.RackUnit", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2018-08-16' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2018-08-16T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2019-02-14T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2020-02-14T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of HW Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2020-02-14T00:00:00Z", "Description": "The last-possible date a routine failure analysis may be performed to determine the cause of hardware product failure or defect.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Routine Failure Analysis Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2020-02-14T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2023-05-12T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-02-29T00:00:00Z", "Description": "The last date that Cisco Engineering may release a planned maintenance release or scheduled software remedy for a security vulnerability issue.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Vulnerability/Security Support", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-02-29T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2018-08-16T00:00:00Z", "Description": "The last date that Cisco Engineering may release a planned maintenance release or scheduled software remedy for a security vulnerability issue.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End-of-Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "C220 M4, C240 M4, C460 M4"}, "AdvisoryId": "ucs-c-series-m4-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "computePhysicalSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE 'UCS.*(C220|C240|C460).*M4' and ds1_SourceObjectType = 'compute.RackUnit'"}], "Type": "intersightApi"}], "CreateTime": "2023-03-10T08:06:56.653Z", "DatePublished": "2018-08-16T00:00:00Z", "DateUpdated": "2019-08-24T00:00:00Z", "Description": "Cisco announces the end-of-sale and end-of-life dates for the Cisco Unified Computing System C-Series Rack Servers (C220 M4, C240 M4 and C460 M4). The last day to order the affected product(s) was February 14, 2019 . Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) as per End of Life announcement", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-c-series-rack-servers/eos-eol-notice-c51-741235.html", "ModTime": "2026-09-18T18:16:44.355Z", "Moid": "640ae5206f636b2d39dc6a20", "Name": "End-of-Life Announcement for Cisco UCS C-Series Rack Severs (C220 M4, C240 M4 and C460 M4)", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers may be able to use the Cisco Technology Migration Program (TMP) where applicable to trade-in eligible products and receive credit toward the purchase of new Cisco equipment. For more information about Cisco TMP, customers should work with their Cisco Partner or Cisco account team. Cisco Partners can find additional TMP information on Partner Central at [https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html.](https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html)\n\n Customers may be able to continue to purchase the Cisco Unified Computing System C-Series Rack Servers (C220 M4, C240 M4 and C460 M4) through the Cisco Certified Refurbished Equipment program. Refurbished units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Certified Refurbished Equipment program, go to: [https://www.cisco.com/go/eos.](https://www.cisco.com/go/eos)\n\n Service prices for Cisco products are subject to change after the product End-of-Sale date.\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\n For more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\n To subscribe to receive end-of-life/end-of-sale information, go to: [http://www.cisco.com/cisco/support/notifications.html.](http://www.cisco.com/cisco/support/notifications.html)\n", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:44.355Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "compute.Blade", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2023-11-30' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2023-11-30T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-05-30T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-08-28T00:00:00Z", "Description": "The last-possible ship date that can be requested of Cisco and/or its contract manufacturers. Actual ship date is dependent on lead time.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Ship Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2025-05-30T00:00:00Z", "Description": "The last-possible date a routine failure analysis may be performed to determine the cause of hardware product failure or defect.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Routine Failure Analysis Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2025-05-30T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-05-25T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2029-05-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2023-11-30T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "B480 M5"}, "AdvisoryId": "ucs-b480-m5-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "computePhysicalSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE 'UCS.*B480.*M5' and ds1_SourceObjectType = 'compute.Blade'"}], "Type": "intersightApi"}], "CreateTime": "2024-01-12T13:21:15.282Z", "DatePublished": "2023-11-30T00:00:00Z", "DateUpdated": "2023-12-22T00:00:00Z", "Description": "Cisco announces the end-of-sale and end-of-life dates for the Cisco UCS M5 Blade Server (B480 M5). The last day to order the affected product(s) is May 30, 2024. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/servers-unified-computing/ucs-b-series-blade-servers/ucs-m5-blade-server-b480-eol.html", "ModTime": "2026-09-18T18:16:44.319Z", "Moid": "65a13ccb6f636b3901691d62", "Name": "End-of-Life Announcement for the Cisco UCS M5 Blade Server (B480 M5)", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers may be able to use the Cisco Technology Migration Program (TMP) where applicable to trade-in eligible products and receive credit toward the purchase of new Cisco equipment. For more information about Cisco TMP, customers should work with their Cisco Partner or Cisco account team. Cisco Partners can find additional TMP information on Partner Central at [http://www.cisco.com/web/partners/incentives_and_promotions/tmp.html.](http://www.cisco.com/web/partners/incentives_and_promotions/tmp.html)\n\nCustomers may be able to continue to purchase the Cisco UCS M5 Blade Server (B480 M5) through the Cisco Certified Refurbished Equipment program. Refurbished units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Certified Refurbished Equipment program, go to: [http://www.cisco.com/go/eos.](http://www.cisco.com/go/eos.)\n\nThe Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to: [http://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html.](http://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://www.cisco.com/cisco/support/notifications.html.](https://www.cisco.com/cisco/support/notifications.html)", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:44.319Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "equipment.Chassis", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2030-12-31' ) >= -90 and datediff(current_date(), '2030-12-31' ) < 0 )"}], "Type": "restApi"}, {"AffectedObjectType": "compute.Blade", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds2_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds2 where ( datediff(current_date(), '2030-12-31' ) >= -90 and datediff(current_date(), '2030-12-31' ) < 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2030-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of (Hardware) Support", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2030-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 0, "LabelHint": "imminent", "MilestoneType": "lastDateOfSupport", "Name": "Last Date Of Support(LDOS) Date", "ObjectType": "tam.Milestone", "StartOffset": -90}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "B220 M6, 5108 AC2"}, "AdvisoryId": "ucs-b200-m6-5108-ac-ldos-medium", "Ancestors": [], "ApiDataSources": [{"MoType": "equipmentChassis", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_ManagementMode FROM ds1 WHERE ds1_Model RLIKE '(UCSB-5108-AC2)'"}], "Type": "intersightApi"}, {"MoType": "computePhysicalSummary", "Name": "ds2", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds2_Moid, ds2_AccountMoid, ds2_DomainGroupMoid, ds2_RegisteredDevice.Moid as ds2_RegisteredDeviceMoid, ds2_Model FROM ds2 WHERE ds2_Model RLIKE 'UCSB.*B200.*M6'"}], "Type": "intersightApi"}], "CreateTime": "2025-05-14T21:48:02.525Z", "DatePublished": "2025-04-02T00:00:00Z", "DateUpdated": "2025-04-03T00:00:00Z", "Description": "Cisco announced the end-of-sale and end-of-life dates for the Cisco UCS B200 M6 Blade Server and UCS 5108 Blade Server Chassis. The last date of (hardware) support for the affected product(s) is December 31, 2030. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-b-series-blade-servers/ucs-b200-m6-5108-blade-server-chassis-eol.html", "ModTime": "2026-09-18T18:16:44.287Z", "Moid": "68250f926f636b3901fcbbd8", "Name": "Last Date of Support for the Cisco UCS B200 M6 Blade Server and UCS 5108 Blade Server Chassis is imminent", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers may be able to use the Cisco Technology Migration Program (TMP) where applicable to trade-in eligible products and receive credit toward the purchase of new Cisco equipment. For more information about Cisco TMP, customers should work with their Cisco Partner or Cisco account team. Cisco Partners can find additional TMP information on Partner Central at: [https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html](https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html).\n\nCustomers may be able to continue to purchase the Cisco UCS B200 M6 Blade Server and UCS 5108 Blade Server Chassis through the Cisco Refresh (certified remanufactured) program. Remanufactured units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Refresh program, go to: [https://www.cisco.com/c/en/us/products/remanufactured.html](https://www.cisco.com/c/en/us/products/remanufactured.html).\n\nThe Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to: [https://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html](https://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html).\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html](https://www.cisco.com/c/en/us/products/eos-eol-policy.html).\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html](https://www.cisco.com/c/en/us/products/warranty-listing.html).\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://www.cisco.com/cisco/support/notifications.html](https://www.cisco.com/cisco/support/notifications.html).", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:44.287Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "equipment.Chassis", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2030-12-31' ) >= -365 and datediff(current_date(), '2030-12-31' ) < -180 )"}], "Type": "restApi"}, {"AffectedObjectType": "compute.Blade", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds2_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds2 where ( datediff(current_date(), '2030-12-31' ) >= -365 and datediff(current_date(), '2030-12-31' ) < -180 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2030-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of (Hardware) Support", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2030-12-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": -180, "LabelHint": "upcoming", "MilestoneType": "lastDateOfSupport", "Name": "Last Date Of Support(LDOS) Date", "ObjectType": "tam.Milestone", "StartOffset": -365}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "B220 M6, 5108 AC2"}, "AdvisoryId": "ucs-b200-m6-5108-ac-ldos-info", "Ancestors": [], "ApiDataSources": [{"MoType": "equipmentChassis", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_ManagementMode FROM ds1 WHERE ds1_Model RLIKE '(UCSB-5108-AC2)'"}], "Type": "intersightApi"}, {"MoType": "computePhysicalSummary", "Name": "ds2", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds2_Moid, ds2_AccountMoid, ds2_DomainGroupMoid, ds2_RegisteredDevice.Moid as ds2_RegisteredDeviceMoid, ds2_Model FROM ds2 WHERE ds2_Model RLIKE 'UCSB.*B200.*M6'"}], "Type": "intersightApi"}], "CreateTime": "2025-05-14T21:48:02.481Z", "DatePublished": "2025-04-02T00:00:00Z", "DateUpdated": "2025-04-03T00:00:00Z", "Description": "Cisco announced the end-of-sale and end-of-life dates for the Cisco UCS B200 M6 Blade Server and UCS 5108 Blade Server Chassis. The last date of (hardware) support for the affected product(s) is December 31, 2030. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-b-series-blade-servers/ucs-b200-m6-5108-blade-server-chassis-eol.html", "ModTime": "2026-09-18T18:16:44.255Z", "Moid": "68250f926f636b3901fcbbd3", "Name": "Last Date of Support for the Cisco UCS B200 M6 Blade Server and UCS 5108 Blade Server Chassis is upcoming", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers may be able to use the Cisco Technology Migration Program (TMP) where applicable to trade-in eligible products and receive credit toward the purchase of new Cisco equipment. For more information about Cisco TMP, customers should work with their Cisco Partner or Cisco account team. Cisco Partners can find additional TMP information on Partner Central at: [https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html](https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html).\n\nCustomers may be able to continue to purchase the Cisco UCS B200 M6 Blade Server and UCS 5108 Blade Server Chassis through the Cisco Refresh (certified remanufactured) program. Remanufactured units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Refresh program, go to: [https://www.cisco.com/c/en/us/products/remanufactured.html](https://www.cisco.com/c/en/us/products/remanufactured.html).\n\nThe Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to: [https://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html](https://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html).\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html](https://www.cisco.com/c/en/us/products/eos-eol-policy.html).\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html](https://www.cisco.com/c/en/us/products/warranty-listing.html).\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://www.cisco.com/cisco/support/notifications.html](https://www.cisco.com/cisco/support/notifications.html).", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:44.255Z"}
