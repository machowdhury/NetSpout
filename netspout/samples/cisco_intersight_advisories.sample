{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2028-04-30' ) >= -30 and datediff(current_date(), '2028-04-30' ) < 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2028-04-30T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Software Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2030-04-30T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of (Software) Support", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2028-04-30T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 0, "LabelHint": "imminent", "MilestoneType": "endOfSoftwareMaintenanceDate", "Name": "End of SW Maintenance Releases(EOSM) Date", "ObjectType": "tam.Milestone", "StartOffset": -30}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "4.3"}, "AdvisoryId": "ucs-4.3-eosm-critical", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_Version, ds1_BundleVersion FROM ds1 WHERE (ds1_Version RLIKE '^4\\\\.3' OR ds1_BundleVersion RLIKE '^4\\\\.3') and ds1_SourceObjectType = 'network.Element' and ds1_ManagementMode = 'UCSM'"}], "Type": "intersightApi"}], "CreateTime": "2026-09-18T18:16:43.376Z", "DatePublished": "2026-09-15T00:00:00Z", "DateUpdated": "2026-09-15T00:00:00Z", "Description": "**EOL15978**\n\nCisco announced the end-of-sale and end-of-life dates for the Cisco UCS Manager Release 4.3. The end of software maintenance releases date for the affected product(s) is April 30, 2028. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-release-4-3-eol.html", "ModTime": "2026-09-18T18:16:43.379Z", "Moid": "6aad800b6f636b3901625dcb", "Name": "End of Software Maintenance Releases for the Cisco UCS Manager Release 4.3 is imminent", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "**Product Migration Options**\n\nCisco provides the Intersight Managed Mode Transition Tool to assist customers in migrating from UCS Manager to Intersight Managed Mode.\n\nFor additional information related to the UCS Manager End-of-Sale and End-of-Life, please refer to the FAQs here: [https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-eol-faq.html.](https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-eol-faq.html)\n\nFor more information about the Cisco Intersight Managed Mode Transition Tool, go to: [Cisco Intersight Managed Mode Transition Tool User Guide.](https://www.cisco.com/c/en/us/td/docs/unified_computing/Intersight/IMM-Transition-Tool/User-Guide-5-0/b_imm_transition_tool_user_guide_5_0/m_overview_imm_tt_5_0.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html.](https://www.cisco.com/c/en/us/products/eos-eol-policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html.](https://www.cisco.com/c/en/us/products/warranty-listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications.](https://cway.cisco.com/mynotifications)", "S3DataSources": [], "Severity": {"Level": "critical", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.379Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2026-09-15' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2026-09-15T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2027-04-30T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-04-30T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Software Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2030-04-30T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of (Software) Support", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2026-09-15T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "4.3"}, "AdvisoryId": "ucsm-4.3-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_Version, ds1_BundleVersion FROM ds1 WHERE (ds1_Version RLIKE '^4\\\\.3' OR ds1_BundleVersion RLIKE '^4\\\\.3') and ds1_SourceObjectType = 'network.Element' and ds1_ManagementMode = 'UCSM'"}], "Type": "intersightApi"}], "CreateTime": "2026-09-18T18:16:43.33Z", "DatePublished": "2026-09-15T00:00:00Z", "DateUpdated": "2026-09-15T00:00:00Z", "Description": "**EOL15978**\n\nCisco announces the end-of-sale and end-of-life dates for the Cisco UCS Manager Release 4.3. The last day to order the affected product(s) is April 30, 2027. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin. For customers with active and paid service and support contracts, support will be available under the terms and conditions of customers' service contract.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-release-4-3-eol.html", "ModTime": "2026-09-18T18:16:43.332Z", "Moid": "6aad800b6f636b3901625dc6", "Name": "End-of-Sale and End-of-Life Announcement for the Cisco UCS Manager Release 4.3", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "**Product part numbers**\n\nThe following table lists the Cisco UCS Manager product part numbers affected by this announcement and the suggested Cisco Intersight migration product part numbers.\n\n| **End-of-Sale Product Part Number** | **Product Description** | **Migration Product Part Number** | **Migration Product Description** |\n|---|---|---|---|\n| N10-MGT019 | UCS Manager v4.3 | DC-MGT-IS-PVAPP-AD | Infrastructure Services PVA - Advantage |\n| N10-MGT019 | UCS Manager v4.3 | DC-MGT-IS-PVAPP-ES | Infrastructure Services PVA - Essentials |\n| N10-MGT019 | UCS Manager v4.3 | DC-MGT-IS-SAAS-AD | Infrastructure Services SaaS/CVA - Advantage |\n| N10-MGT019 | UCS Manager v4.3 | DC-MGT-IS-SAAS-ES | Infrastructure Services SaaS/CVA - Essentials |\n| N20-FW019 | UCS 5108 Blade Chassis FW Package 4.3 | DC-MGT-IS-PVAPP-AD | Infrastructure Services PVA - Advantage |\n| N20-FW019 | UCS 5108 Blade Chassis FW Package 4.3 | DC-MGT-IS-PVAPP-ES | Infrastructure Services PVA - Essentials |\n| N20-FW019 | UCS 5108 Blade Chassis FW Package 4.3 | DC-MGT-IS-SAAS-AD | Infrastructure Services SaaS/CVA - Advantage |\n| N20-FW019 | UCS 5108 Blade Chassis FW Package 4.3 | DC-MGT-IS-SAAS-ES | Infrastructure Services SaaS/CVA - Essentials |\n\n**Product Migration Options**\n\nCisco provides the Intersight Managed Mode Transition Tool to assist customers in migrating from UCS Manager to Intersight Managed Mode.\n\nFor more information about the Cisco Intersight Managed Mode Transition Tool, go to: [Cisco Intersight Managed Mode Transition Tool User Guide.](https://www.cisco.com/c/en/us/td/docs/unified_computing/Intersight/IMM-Transition-Tool/User-Guide-5-0/b_imm_transition_tool_user_guide_5_0/m_overview_imm_tt_5_0.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [https://www.cisco.com/c/en/us/products/eos-eol-policy.html.](https://www.cisco.com/c/en/us/products/eos-eol-policy.html)\n\nFor more information about the Cisco Product Warranties, go to: [https://www.cisco.com/c/en/us/products/warranty-listing.html.](https://www.cisco.com/c/en/us/products/warranty-listing.html)\n\nTo subscribe to receive end-of-life/end-of-sale information, go to: [https://cway.cisco.com/mynotifications.](https://cway.cisco.com/mynotifications)", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.332Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2023-02-23' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2023-02-23T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End-of-Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2023-08-24T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2023-11-22T00:00:00Z", "Description": "The last-possible ship date that can be requested of Cisco and/or its contract manufacturers. Actual ship date is dependent on lead time.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Ship Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-08-23T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of SW Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-08-23T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2027-11-19T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-08-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Software", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2023-02-23T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "4.1(3)"}, "AdvisoryId": "ucsm-4.1-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_Version, ds1_BundleVersion FROM ds1 WHERE (ds1_Version RLIKE '^4\\\\.1' OR ds1_BundleVersion RLIKE '^4\\\\.1') and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2023-03-31T18:27:35.398Z", "DatePublished": "2023-02-23T00:00:00Z", "DateUpdated": "2023-02-28T00:00:00Z", "Description": "Cisco announces the end-of-sale and end-of-life dates for the Cisco UCS Manager Release 4.1. The last day to order the affected product(s) is August 24, 2023. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) as shown in release support timeline. For customers with active and paid service and support contracts, support will be available under the terms and conditions of customers' service contract.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-release-4-1-eol.html", "ModTime": "2026-09-18T18:16:43.297Z", "Moid": "642726176f636b3901ae6b89", "Name": "End-of-Life Announcement for Cisco UCS Manager Release 4.1", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Cisco goes through a very rigorous process to ensure that customers receive support. However in rare occasions, due to component supplier limitations, there may be a need for customer to migrate to a part that is an upgrade of something comparable or better than what they previously bought. This may require customer to upgrade to a different Software and OS version or even the closest generation of an equivalent server that may be currently shipping at the time.\n\nCustomers may be able to use the Cisco Technology Migration Program (TMP) where applicable to trade-in eligible products and receive credit toward the purchase of new Cisco equipment. For more information about Cisco TMP, customers should work with their Cisco Partner or Cisco account team. Cisco Partners can find additional TMP information on Partner Central at [https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html.](https://www.cisco.com/web/partners/incentives_and_promotions/tmp.html)\n\n Customers may be able to continue to purchase the Cisco UCS Manager Release 4.1 through the Cisco Certified Refurbished Equipment program. Refurbished units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Certified Refurbished Equipment program, go to [https://www.cisco.com/go/eos.](https://www.cisco.com/go/eos)\n\n Service prices for Cisco products are subject to change after the product End-of-Sale date.\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\n For more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\n To subscribe to receive end-of-life/end-of-sale information, go to: [http://www.cisco.com/cisco/support/notifications.html.](http://www.cisco.com/cisco/support/notifications.html)\n", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.297Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2027-02-28' ) >= -365 and datediff(current_date(), '2027-02-28' ) < -180 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2027-02-28T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support OS Software", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2027-02-28T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete", "EndOffset": -180, "LabelHint": "upcoming", "MilestoneType": "lastDateOfSupport", "Name": "Last Date of Support", "ObjectType": "tam.Milestone", "StartOffset": -365}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "4.0(4)"}, "AdvisoryId": "ucs-4.0-ldos", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_Version FROM ds1 WHERE (ds1_Version RLIKE '^4\\\\.0') and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2023-03-03T01:40:13.975Z", "DatePublished": "2021-11-08T00:00:00Z", "DateUpdated": "2021-11-08T00:00:00Z", "Description": "Cisco has announced the end-of-sale and end-of life dates for the Cisco UCS Manager Release 4.0. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) as per End of Life announcement. The last day to receive service and support for this release is February 28, 2027.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-release-4-0-eol.html", "ModTime": "2026-09-18T18:16:43.266Z", "Moid": "64014ffd6f636b2d391385f8", "Name": "Last Date of Support for Cisco UCS Manager Release 4.0 is upcoming", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers currently running Cisco UCS Manager Release 4.0(x) should upgrade to UCS Manager 4.1 or a later release version which can be found [here.](https://www.cisco.com/c/en/us/support/servers-unified-computing/ucs-manager/products-release-notes-list.html)\n- Management Guide, which includes guidelines and prerequisites, and User Guides can be found [here.](https://www.cisco.com/c/en/us/support/servers-unified-computing/ucs-manager/products-installation-and-configuration-guides-list.html)\n- Release Notes can be found [here](https://www.cisco.com/c/en/us/support/servers-unified-computing/ucs-manager/products-release-notes-list.html).\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html.)\n\n For more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html.)\n\n  To subscribe to receive end-of-life/end-of-sale information, go to: [http://www.cisco.com/cisco/support/notifications.html.](http://www.cisco.com/cisco/support/notifications.html.)", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.266Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "network.Element", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2021-11-08' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2021-11-08T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End-of-Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2022-02-07T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2022-05-08T00:00:00Z", "Description": "The last-possible ship date that can be requested of Cisco and/or its contract manufacturers. Actual ship date is dependent on lead time.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Ship Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2023-02-07T00:00:00Z", "Description": "The last date that Cisco Engineering may release any final software maintenance releases or bug fixes. After this date, Cisco Engineering will no longer develop, repair, maintain, or test the product software.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of SW Maintenance Releases Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2023-02-07T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2026-05-05T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2027-02-28T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Software", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2021-11-08T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "4.0(4)"}, "AdvisoryId": "ucsm-4.0-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "networkElementSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model, ds1_Version FROM ds1 WHERE (ds1_Version RLIKE '^4\\\\.0') and ds1_SourceObjectType = 'network.Element'"}], "Type": "intersightApi"}], "CreateTime": "2023-03-31T18:27:35.313Z", "DatePublished": "2021-11-08T00:00:00Z", "DateUpdated": "2021-11-08T00:00:00Z", "Description": "Cisco has announced the end-of-sale and end-of life dates for the Cisco UCS Manager Release 4.0. The last day to order the affected product(s) was February 7, 2022. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) as shown in release support timeline. For customers with active and paid service and support contracts, support will be available under the terms and conditions of customers' service contract.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/servers-unified-computing/ucs-manager/ucs-manager-release-4-0-eol.html", "ModTime": "2026-09-18T18:16:43.231Z", "Moid": "642726176f636b3901ae6b7e", "Name": "End-of-Life Announcement for Cisco UCS Manager Release 4.0", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Cisco goes through a very rigorous process to ensure that customers receive support. However in rare occasions, due to component supplier limitations, there may be a need for customer to migrate to a part that is an upgrade of something comparable or better than what they previously bought. This may require customer to upgrade to a different Software and OS version or even the closest generation of an equivalent server that may be currently shipping at the time.\n\nService prices for Cisco products are subject to change after the product End-of-Sale date.\n\n The Cisco Takeback and Recycle program helps businesses properly dispose of surplus products that have reached their end of useful life. The program is open to all business users of Cisco equipment and its associated brands and subsidiaries. For more information, go to:[https://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html](https://www.cisco.com/web/about/ac227/ac228/ac231/about_cisco_takeback_recycling.html.)\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\n For more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\n To subscribe to receive end-of-life/end-of-sale information, go to: [http://www.cisco.com/cisco/support/notifications.html.](http://www.cisco.com/cisco/support/notifications.html)\n", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.231Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "compute.RackUnit", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2023-05-01' ) >= 0 )"}], "Type": "restApi"}, {"AffectedObjectType": "compute.Blade", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds2_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds2 where ( datediff(current_date(), '2023-05-01' ) >= 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2023-05-01T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Life Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2023-10-30T00:00:00Z", "Description": "The last date to order the product through Cisco point-of-sale mechanisms. The product is no longer for sale after this date.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Sale Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-01-28T00:00:00Z", "Description": "The last-possible ship date that can be requested of Cisco and/or its contract manufacturers. Actual ship date is dependent on lead time.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Ship Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-10-29T00:00:00Z", "Description": "The last-possible date a routine failure analysis may be performed to determine the cause of hardware product failure or defect.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Routine Failure Analysis Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2024-10-29T00:00:00Z", "Description": "For equipment and software that is not covered by a service-and-support contract, this is the last date to order a new service-and-support contract or add the equipment and/or software to an existing service-and-support contract.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of New Service Attachment Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-01-25T00:00:00Z", "Description": "The last date to extend or renew a service contract for the product.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "End of Service Contract Renewal Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, {"Date": "2028-10-31T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2023-05-01T00:00:00Z", "Description": "The date the document that announces the end-of-sale and end-of-life of a product is distributed to the general public.", "EndOffset": 2147483647, "LabelHint": "info", "MilestoneType": "endOfLifeAnnouncementDate", "Name": "End of Life(EOL) Announcement Date", "ObjectType": "tam.Milestone", "StartOffset": 0}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "HX B200 M5, HX C220 M5, HX C240 M5, HX C480 M5"}, "AdvisoryId": "hx-m5-eol-info", "Ancestors": [], "ApiDataSources": [{"MoType": "computePhysicalSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE 'HX.*(220C|240C|480C).*M5' and ds1_SourceObjectType = 'compute.RackUnit'"}], "Type": "intersightApi"}, {"MoType": "computePhysicalSummary", "Name": "ds2", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds2_Moid, ds2_AccountMoid, ds2_DomainGroupMoid, ds2_RegisteredDevice.Moid as ds2_RegisteredDeviceMoid, ds2_Model FROM ds2 WHERE ds2_Model RLIKE 'HX.*B200.*M5' and ds2_SourceObjectType = 'compute.Blade'"}], "Type": "intersightApi"}], "CreateTime": "2023-05-25T23:06:54.894Z", "DatePublished": "2023-05-01T00:00:00Z", "DateUpdated": "2023-05-03T00:00:00Z", "Description": "Cisco announces the end-of-sale and end-of-life dates for the Cisco HyperFlex M5. The last day to order the affected product(s) is October 30, 2023. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on EoL bulletin.\n\n**PIDs that are going End of Life**: HX220C-M5SX, HX240C-M5L, HX240C-M5SD, HX240C-M5SX, HXAF-E-240-M5SX, HXAF220C-M5SN, HXAF240C-M5SD, HXAF240C-M5SX, HX-E-220M5SX, HX-E-240-M5SX, HX220C-M5SX, HX240C-M5L, HX240C-M5SX, HXAF-E-220M5SX, HXAF220C-M5SN, HXAF220C-M5SX, HXAF240C-M5SX, HX B200 M5, HX C220 M5, HX C240 M5, HX C480 M5", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/hyperconverged-infrastructure/hyperflex-hx-series/hyperconverged-m5-eol.html", "ModTime": "2026-09-18T18:16:43.193Z", "Moid": "646fea0e6f636b39011492fd", "Name": "End-of-Life Announcement for Cisco HyperFlex M5 (HX Hybrid, HX All Flash, HX Edge, HX M5 Compute)", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": ["https://www.cisco.com/c/en/us/products/collateral/hyperconverged-infrastructure/hyperflex-hx-series/hyperflex-compute-m5-eol.html"], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Cisco goes through a very rigorous process to ensure that customers receive support. However, in rare occasions, due to component supplier limitations, there may be a need for customer to migrate to a part that is an upgrade of something comparable or better than what they previously bought. This may require customer to upgrade to a different Software and OS version or even the closest generation of an equivalent server that may be currently shipping at the time.\n\nCustomers may be able to use the Cisco Technology Migration Program (TMP) where applicable to trade-in eligible products and receive credit toward the purchase of new Cisco equipment. For more information about Cisco TMP, customers should work with their Cisco Partner or Cisco account team. Cisco Partners can find additional TMP information on Partner Central at [http://www.cisco.com/web/partners/incentives_and_promotions/tmp.html](http://www.cisco.com/web/partners/incentives_and_promotions/tmp.html).\n\nCustomers may be able to continue to purchase the Cisco HyperFlex M5 platforms through the Cisco Certified Refurbished Equipment program. Refurbished units may be available in limited supply for sale in certain countries on a first-come, first-served basis until the Last Date of Support has been reached. For information about the Cisco Certified Refurbished Equipment program, go to: [http://www.cisco.com/go/eos](http://www.cisco.com/go/eos).\n\nService prices for Cisco products are subject to change after the product End of Sale date.", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.193Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "compute.RackUnit", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2024-02-29' ) >= -365 and datediff(current_date(), '2024-02-29' ) < -180 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [{"Date": "2024-02-29T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": 2147483647, "LabelHint": "upcoming", "MilestoneType": "unknown", "Name": "Last Date of Support Hardware", "ObjectType": "tam.Milestone", "StartOffset": 0}], "Description": "", "Milestone": {"Date": "2024-02-29T00:00:00Z", "Description": "The last date to receive applicable service and support for the product as entitled by active service contracts or by warranty terms and conditions. After this date, all support services for the product are unavailable, and the product becomes obsolete.", "EndOffset": -180, "LabelHint": "upcoming", "MilestoneType": "lastDateOfSupport", "Name": "Last Date Of Support(LDOS) Date", "ObjectType": "tam.Milestone", "StartOffset": -365}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "HX220c M4, HX240c M4, HX220c AF M4, HX240c AF M4"}, "AdvisoryId": "hx-m4-ldos", "Ancestors": [], "ApiDataSources": [{"MoType": "computePhysicalSummary", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_Model FROM ds1 WHERE ds1_Model RLIKE 'HX.*(220C|240C).*M4' and ds1_SourceObjectType = 'compute.RackUnit'"}], "Type": "intersightApi"}], "CreateTime": "2023-04-13T21:59:18.829Z", "DatePublished": "2018-08-16T00:00:00Z", "DateUpdated": "2021-04-15T00:00:00Z", "Description": "Cisco has announced the end-of-sale and end-of-life dates for the Cisco HyperFlex HX-Series (HX220c M4, HX240c M4, HX220c AF M4 and HX240c AF M4). The last day to order the affected product(s) was February 14, 2019. Customers with active service contracts will continue to receive support from the Cisco Technical Assistance Center (TAC) based on End of Life announcement. The last day to receive applicable service and support is February 29, 2024.", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://www.cisco.com/c/en/us/products/collateral/hyperconverged-infrastructure/hyperflex-hx-series/eos-eol-notice-c51-741237.html", "ModTime": "2026-09-18T18:16:43.163Z", "Moid": "64387b366f636b390194a0b0", "Name": "Last Date of Support for Cisco HyperFlex HX-Series (HX220c M4, HX240c M4, HX220c AF M4 and HX240c AF M4) is upcoming", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers currently running Cisco HyperFlex HX-Series HX220c M4, HX240c M4, HX220c AF M4 and HX240c AF M4 hardware should upgrade to Cisco HyperFlex HX-Series M5 or later hardware.\n- Cisco HyperFlex HX-Series Data Sheets can be found [here.](https://www.cisco.com/c/en/us/products/hyperconverged-infrastructure/hyperflex-hx-series/datasheet-listing.html)\n\nFor more information about the Cisco End-of-Life Policy, go to: [http://www.cisco.com/en/US/products/products_end-of-life_policy.html.](http://www.cisco.com/en/US/products/products_end-of-life_policy.html)\n\n For more information about the Cisco Product Warranties, go to: [http://www.cisco.com/en/US/products/prod_warranties_listing.html.](http://www.cisco.com/en/US/products/prod_warranties_listing.html)\n\n To subscribe to receive end-of-life/end-of-sale information, go to: [http://www.cisco.com/cisco/support/notifications.html.](http://www.cisco.com/cisco/support/notifications.html)\n", "S3DataSources": [], "Severity": {"Level": "info", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.163Z"}
{"AccountMoid": "5960901ca94eba000127e33a", "Actions": [{"AffectedObjectType": "hyperflex.Cluster", "AlertType": "eolAdvisory", "Identifiers": [{"Name": "Moid", "ObjectType": "tam.Identifiers", "Value": "ds1_Moid"}], "Name": "", "ObjectType": "tam.Action", "OperationType": "create", "Queries": [{"Name": "qds2", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT * FROM ds1 where ( datediff(current_date(), '2022-10-15' ) >= -30 and datediff(current_date(), '2022-10-15' ) < 0 )"}], "Type": "restApi"}], "AdvisoryDetails": {"AllMilestones": [], "Description": "", "Milestone": {"Date": "2022-10-15T00:00:00Z", "Description": "The last date to receive service and support for the software. After this date, all support services for the software are unavailable, and the software becomes obsolete.", "EndOffset": 0, "LabelHint": "imminent", "MilestoneType": "lastDateOfSupport", "Name": "Last Date of Support", "ObjectType": "tam.Milestone", "StartOffset": -30}, "ObjectType": "tam.EolAdvisoryDetails", "Release": "6.5/6.7"}, "AdvisoryId": "hx-esx-6.x-ldos-medium", "Ancestors": [], "ApiDataSources": [{"MoType": "hyperflexCluster", "Name": "ds1", "ObjectType": "tam.ApiDataSource", "Queries": [{"Name": "qds1", "ObjectType": "tam.QueryEntry", "Priority": 1, "Query": "SELECT ds1_Moid, ds1_AccountMoid, ds1_DomainGroupMoid, ds1_RegisteredDevice.Moid as ds1_RegisteredDeviceMoid, ds1_HypervisorVersion FROM ds1 WHERE (ds1_HypervisorVersion RLIKE 'VMware ESXi 6\\\\.[5,7]')"}], "Type": "intersightApi"}], "CreateTime": "2022-10-14T02:30:13.399Z", "DatePublished": "2022-08-17T00:00:00Z", "DateUpdated": "2022-08-17T00:00:00Z", "Description": "VMware has announced vSphere 6.5 and 6.7 end of general support as of October 15, 2022. Cisco strongly recommends upgrading as soon as possible to a supported VMware vSphere 7.0 release and follow Cisco\u2019s recommendations as outlined in [General Recommendation for New and Existing Deployments](https://www.cisco.com/c/en/us/td/docs/hyperconverged_systems/HyperFlex_HX_DataPlatformSoftware/release-guidelines-and-support-timeline/b-recommended-hx-data-platform-sw-releases/m-recommended-releases.html#id_119262).", "DomainGroupMoid": "5b2541877a7662743465cc89", "ExecuteOnPod": "tier1", "ExternalUrl": "https://lifecycle.vmware.com/", "ModTime": "2026-09-18T18:16:43.131Z", "Moid": "6348c9b56f636b2d39fa76f5", "Name": "The last date to receive service and support for VMware ESXi 6.5/6.7 is imminent", "ObjectType": "tam.AdvisoryDefinition", "Organization": {"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}, "OtherRefUrls": [], "Owners": ["5960901ca94eba000127e33a", "shared"], "PermissionResources": [{"Moid": "5dde9f896972652d3353a082", "ObjectType": "organization.Organization", "link": "https://intersight.com/api/v1/organization/Organizations/5dde9f896972652d3353a082"}], "Recommendation": "Customers currently running VMware vSphere 6.5 or 6.7 should follow Cisco\u2019s recommendations as outlined in [General Recommendation for New and Existing Deployments](https://www.cisco.com/c/en/us/td/docs/hyperconverged_systems/HyperFlex_HX_DataPlatformSoftware/release-guidelines-and-support-timeline/b-recommended-hx-data-platform-sw-releases/m-recommended-releases.html#id_119262) and upgrade the vSphere to supported vSphere 7.0 version before October 15, 2022.", "S3DataSources": [], "Severity": {"Level": "medium", "ObjectType": "tam.EolSeverity"}, "SharedScope": "shared", "State": "ready", "Tags": [], "Type": "eolAdvisory", "Version": "1.0", "Workaround": "", "account_name": "MAPLE", "updated_at": "2026-09-18T18:16:43.131Z"}
